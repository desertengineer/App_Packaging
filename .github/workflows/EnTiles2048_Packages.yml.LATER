name: Build EnTiles 2048

on:
  push:
    branches:
      - main
    paths:
      - 'Apps/EnTiles2048/**'
      - '.github/workflows/EnTiles2048_Packages.yml'
  workflow_dispatch:

permissions:
  contents: read

jobs:
  # --- SIGNED ANDROID BUILD ---
  build-android:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: Apps/EnTiles2048
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4.2.2

      - name: Setup Node.js
        uses: actions/setup-node@v4.2.0
        with:
          node-version: 22

      - name: Prepare Web Directory
        run: |
          mkdir -p dist
          cp www/index.html www/index.js www/index.css www/manifest.json www/service-worker.js dist/ || true
          cp -r www/assets dist/ || true

      - name: Install Dependencies
        run: |
          npm init -y
          npm install @capacitor/core@6 @capacitor/cli@6 @capacitor/android@6

      - name: Inject Capacitor Configuration Blueprint
        run: |
          cat << 'EOF' > capacitor.config.json
          {
            "appId": "com.desertengineer.tilemaster2048",
            "appName": "EnTiles 2048",
            "webDir": "dist"
          }
          EOF

      - name: Initialize or Sync Android Platform
        run: |
          if [ ! -d "android" ]; then
            echo "Building Android core framework structures..."
            npx cap add android
          else
            echo "Syncing updated production asset structures..."
            npx cap sync android
          fi

      - name: Setup Java
        uses: actions/setup-java@v4.4.0
        with:
          distribution: 'zulu'
          java-version: '21'

      - name: Resolve Android Kotlin Duplicate Classes
        run: |
          cat << 'EOF' >> android/build.gradle
          allprojects {
              configurations.configureEach { configuration ->
                  configuration.exclude group: 'org.jetbrains.kotlin', module: 'kotlin-stdlib-jdk7'
                  configuration.exclude group: 'org.jetbrains.kotlin', module: 'kotlin-stdlib-jdk8'
              }
          }
          EOF

      - name: Decode Android Keystore
        run: |
          echo "${{ secrets.ANDROID_KEYSTORE_BASE64 }}" | base64 --decode > android/app/release.keystore

      - name: Build and Sign Release APK via Native Gradle
        env:
          ORG_GRADLE_PROJECT_androidInjectedSigningStoreFile: ${{ github.workspace }}/Apps/EnTiles2048/android/app/release.keystore
          ORG_GRADLE_PROJECT_androidInjectedSigningStorePassword: ${{ secrets.ANDROID_KEYSTORE_PASSWORD }}
          ORG_GRADLE_PROJECT_androidInjectedSigningKeyAlias: ${{ secrets.ANDROID_KEY_ALIAS }}
          ORG_GRADLE_PROJECT_androidInjectedSigningKeyPassword: ${{ secrets.ANDROID_KEY_PASSWORD }}
        run: |
          cd android
          ./gradlew assembleRelease

      # 🚀 FIX: Improved search to dynamically catch any output APK in the build tree safely
      - name: Locate and Rename Output Binary
        run: |
          mkdir -p final_output
          find android/app/build/outputs/ -name "*.apk" -exec cp {} final_output/EnTiles2048-Final.apk \;

      - name: Upload Verified APK
        uses: actions/upload-artifact@v4.6.1
        with:
          name: EnTiles2048-Android-Release
          path: Apps/EnTiles2048/final_output/EnTiles2048-Final.apk


  # --- SIGNED iOS BUILD & TESTFLIGHT DELIVERY ---
  build-ios:
    runs-on: macos-latest
    defaults:
      run:
        working-directory: Apps/EnTiles2048
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4.2.2

      - name: Setup Node.js
        uses: actions/setup-node@v4.2.0
        with:
          node-version: 22

      - name: Prepare Web Directory
        run: |
          mkdir -p dist
          cp www/index.html www/index.js www/index.css www/manifest.json www/service-worker.js dist/ || true
          cp -r www/assets dist/ || true

      - name: Install Dependencies
        run: |
          npm init -y
          npm install @capacitor/core@6 @capacitor/cli@6 @capacitor/ios@6

      - name: Inject Capacitor Configuration Blueprint
        run: |
          cat << 'EOF' > capacitor.config.json
          {
            "appId": "com.desertengineer.tilemaster2048",
            "appName": "EnTiles 2048",
            "webDir": "dist"
          }
          EOF

      - name: Initialize or Sync iOS Platform
        run: |
          if [ ! -d "ios" ]; then
            echo "Building iOS core wrapper assets..."
            npx cap add ios
          else
            echo "Synchronizing current web directory variables..."
            npx cap sync ios
          fi

      - name: Setup Xcode Command Line Tools
        run: sudo xcode-select -s /Applications/Xcode.app

      - name: Import Apple Certificate to Keychain
        env:
          BUILD_CERTIFICATE_BASE64: ${{ secrets.APPLE_CERTIFICATE_P12 }}
          P12_PASSWORD: ${{ secrets.APPLE_CERTIFICATE_PASS }}
          KEYCHAIN_PASSWORD: "temp_keychain_pass_${{ github.run_id }}"
        run: |
          CERTIFICATE_PATH=$RUNNER_TEMP/build_certificate.p12
          KEYCHAIN_PATH=$RUNNER_TEMP/app-signing.keychain-db
          
          # Decode certificate
          echo -n "$BUILD_CERTIFICATE_BASE64" | base64 --decode -o $CERTIFICATE_PATH
          
          # Create keychain
          security create-keychain -p "$KEYCHAIN_PASSWORD" $KEYCHAIN_PATH
          security set-keychain-settings -lut 21600 $KEYCHAIN_PATH
          security unlock-keychain -p "$KEYCHAIN_PASSWORD" $KEYCHAIN_PATH
          
          # Import certificate
          security import $CERTIFICATE_PATH -P "$P12_PASSWORD" -A -t cert -f pkcs12 -k $KEYCHAIN_PATH
          security list-keychains -d user -s $KEYCHAIN_PATH
          
          echo "✅ Certificate imported successfully"

      - name: Extract Provisioning Profile Details
        env:
          BUILD_PROVISION_PROFILE_BASE64: ${{ secrets.APPLE_PROVISION_PROFILE }}
        run: |
          PP_PATH=$RUNNER_TEMP/build_pp.mobileprovision
          PLIST_PATH=$RUNNER_TEMP/profile.plist
          
          # Decode provisioning profile
          echo -n "$BUILD_PROVISION_PROFILE_BASE64" | base64 --decode -o $PP_PATH
          
          # Extract profile information
          security cms -D -i "$PP_PATH" > $PLIST_PATH
          
          # Extract UUID
          PROFILE_UUID=$(/usr/libexec/PlistBuddy -c "Print :UUID" $PLIST_PATH)
          echo "PROFILE_UUID=$PROFILE_UUID" >> $GITHUB_ENV
          
          # Extract Team ID
          TEAM_ID=$(/usr/libexec/PlistBuddy -c "Print :TeamIdentifier:0" $PLIST_PATH)
          echo "APPLE_TEAM_ID=$TEAM_ID" >> $GITHUB_ENV
          
          # Extract App Name
          APP_NAME=$(/usr/libexec/PlistBuddy -c "Print :Name" $PLIST_PATH)
          echo "PROFILE_NAME=$APP_NAME" >> $GITHUB_ENV
          
          # Copy to provisioning profiles directory
          mkdir -p ~/Library/MobileDevice/Provisioning\ Profiles
          cp $PP_PATH ~/Library/MobileDevice/Provisioning\ Profiles/$PROFILE_UUID.mobileprovision
          
          echo "✅ Profile UUID: $PROFILE_UUID"
          echo "✅ Team ID: $TEAM_ID"
          echo "✅ Profile Name: $APP_NAME"

      - name: Install CocoaPods Dependencies
        run: |
          cd ios/App
          pod repo update
          pod install --repo-update

      - name: Build and Archive iOS App
        run: |
          cd ios/App
          echo "Building with UUID: ${{ env.PROFILE_UUID }}"
          echo "Team ID: ${{ env.APPLE_TEAM_ID }}"
          
          xcodebuild archive \
            -workspace App.xcworkspace \
            -scheme App \
            -configuration Release \
            -archivePath $RUNNER_TEMP/App.xcarchive \
            -derivedDataPath $RUNNER_TEMP/DerivedData \
            CODE_SIGNING_IDENTITY="Apple Distribution" \
            CODE_SIGN_STYLE="Manual" \
            DEVELOPMENT_TEAM="${{ env.APPLE_TEAM_ID }}" \
            PROVISIONING_PROFILE_SPECIFIER="${{ env.PROFILE_UUID }}" \
            -verbose

      - name: Export IPA Package
        run: |
          mkdir -p ios/App/output
          cat <<EOF > exportOptions.plist
          <?xml version="1.0" encoding="UTF-8"?>
          <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
          <plist version="1.0">
          <dict>
            <key>method</key>
            <string>app-store</string>
            <key>teamID</key>
            <string>${{ env.APPLE_TEAM_ID }}</string>
            <key>signingStyle</key>
            <string>manual</string>
            <key>compileBitcode</key>
            <false/>
            <key>provisioningProfiles</key>
            <dict>
              <key>com.desertengineer.tilemaster2048</key>
              <string>${{ env.PROFILE_UUID }}</string>
            </dict>
          </dict>
          </plist>
          EOF
          
          echo "Export Options:"
          cat exportOptions.plist
          
          xcodebuild -exportArchive \
            -archivePath $RUNNER_TEMP/App.xcarchive \
            -exportOptionsPlist exportOptions.plist \
            -exportPath ios/App/output \
            -verbose

      - name: Verify IPA Output
        run: |
          echo "Checking for IPA files..."
          find ios/App/output -type f -name "*.ipa" -o -name "*.plist"
          ls -lah ios/App/output/
          
          IPA_PATH=$(find ios/App/output -name "*.ipa" | head -n 1)
          if [ -z "$IPA_PATH" ]; then
            echo "❌ ERROR: No IPA file found in output!"
            exit 1
          fi
          echo "✅ IPA found: $IPA_PATH"
          echo "IPA_PATH=$IPA_PATH" >> $GITHUB_ENV

      - name: Upload Signed IPA to Artifacts
        uses: actions/upload-artifact@v4.6.1
        with:
          name: EnTiles2048-iOS-Release
          path: Apps/EnTiles2048/ios/App/output/*.ipa

      - name: Upload to TestFlight via App Store Connect API
        if: success()
        env:
          KEY_ID: ${{ secrets.APP_STORE_CONNECT_KEY_ID }}
          ISSUER_ID: ${{ secrets.APP_STORE_CONNECT_ISSUER_ID }}
          KEY_CONTENT: ${{ secrets.APP_STORE_CONNECT_KEY_CONTENT }}
        run: |
          API_KEYS_DIR=~/private_keys
          mkdir -p "$API_KEYS_DIR"
          echo "$KEY_CONTENT" > "$API_KEYS_DIR/AuthKey_$KEY_ID.p8"
          chmod 600 "$API_KEYS_DIR/AuthKey_$KEY_ID.p8"
          
          IPA_PATH=$(find ios/App/output -name "*.ipa" | head -n 1)
          
          if [ -z "$IPA_PATH" ]; then
            echo "❌ ERROR: IPA file not found in output directory!"
            exit 1
          fi
          
          echo "✅ IPA found: $IPA_PATH"
          echo "📦 Uploading to TestFlight via App Store Connect API..."
          
          xcrun notarytool submit "$IPA_PATH" \
            --key-id "$KEY_ID" \
            --issuer-id "$ISSUER_ID" \
            --key "$API_KEYS_DIR/AuthKey_$KEY_ID.p8" \
            --wait
          
          echo "✅ TestFlight upload complete!"